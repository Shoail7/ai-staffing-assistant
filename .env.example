# ==========================================
# AI Staffing Assistant Configuration
# ==========================================

# Conversational LLM Settings
# Selectable providers: "gemini", "groq", "openrouter", "ollama"
LLM_PROVIDER=gemini

# Google AI Studio (Free tier Gemini Flash)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (Free tier Llama models)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Free tier models ending in :free)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (Local LLM, no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Decision Engine Settings: Jev by TypeSafe AI
# Pinned model version (do not use jev-latest)
JEV_MODEL=jev-1.13.0
# TypeSafe API Key (leave blank to run in mock mode)
TYPESAFE_API_KEY=
# Explicit mock mode flag: true / false
JEV_MOCK=true

# Low-Confidence & Workload Thresholds
MIN_CONFIDENCE=0.60
TIE_MARGIN=0.05
HIGH_BURNOUT_PROB=0.70

# Ranking Weights (Sum roughly to 1.0)
WEIGHT_SKILL=0.35
WEIGHT_AVAILABILITY=0.25
WEIGHT_BURNOUT=0.20
WEIGHT_SENIORITY=0.15
WEIGHT_COST=0.05

# Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./staffing.db
